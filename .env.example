# Copy this file to .env and fill in your values

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── Email (Gmail recommended) ─────────────────────────────────────────────────
# Your Gmail address
SMTP_USER=you@gmail.com

# Gmail App Password — NOT your regular Gmail password.
# How to get one: https://myaccount.google.com/apppasswords
# (Requires 2-factor authentication to be enabled on your Google account)
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Who to send the briefing to (can be the same as SMTP_USER, or any address)
EMAIL_TO=you@gmail.com

# ── Instapaper (reader.py) ───────────────────────────────────────────────────
# Your Instapaper login: email or username, and the account password (leave
# empty if the account has none — Instapaper allows passwordless accounts).
INSTAPAPER_USER=you@example.com
INSTAPAPER_PASSWORD=your-instapaper-password

# ── SMTP settings (defaults work for Gmail — don't change unless using another provider) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
